{
  "expo": {
    "name": "Bus Driver",
    "slug": "transport-driver-capstone",
    "version": "2.1.0",
    "scheme": "busdriver",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transport.driver",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.transport.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16213E"
      },
      "permissions": [
        "CALL_PHONE",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bus Driver shares your bus's location with passengers and the depot while a trip is running, including when the screen is off.",
          "locationWhenInUsePermission": "Bus Driver shares your bus's location with passengers and the depot while a trip is running.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#16213E"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bus Driver uses the camera to photograph your driving licence and ID for your application.",
          "photosPermission": "Bus Driver lets you choose photos of your driving licence and ID for your application."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16213E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5d7b867b-5b0d-4bb3-92f5-4300d2ab0870"
    },
    "extra": {
      "eas": {
        "projectId": "5d7b867b-5b0d-4bb3-92f5-4300d2ab0870"
      }
    },
    "owner": "sofdev007"
  }
}
